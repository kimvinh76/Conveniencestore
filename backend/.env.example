PORT=3001

# ==========================================
# CẤU HÌNH KẾT NỐI VÀ BẢO MẬT BACKEND
# ==========================================
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=ddbm_auth
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ===== EMAIL CONFIGURATION (for Nodemailer) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM_NAME="Hệ thống Cửa hàng tiện lợi"
EMAIL_FROM_ADDRESS=your_email@gmail.com
# Mật khẩu mặc định khi Admin reset password cho tài khoản
DEFAULT_RESET_PASSWORD=123456

# ==========================================
# CẤU HÌNH DATABASE CÁC CHI NHÁNH
# ==========================================

# HUE (Chi nhánh Huế)
HUE_DB_HOST=localhost
HUE_DB_PORT=1401
HUE_DB_USER=sa
HUE_DB_PASSWORD=your_secure_db_password_here
HUE_DB_NAME=Store_H

# SAIGON (Chi nhánh Sài Gòn)
SAIGON_DB_HOST=localhost
SAIGON_DB_PORT=1402
SAIGON_DB_USER=sa
SAIGON_DB_PASSWORD=your_secure_db_password_here
SAIGON_DB_NAME=Store_SG

# HANOI (Chi nhánh Hà Nội)
HANOI_DB_HOST=localhost
HANOI_DB_PORT=1403
HANOI_DB_USER=sa
HANOI_DB_PASSWORD=your_secure_db_password_here
HANOI_DB_NAME=Store_HN

# CENTRAL (Trung tâm)
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=1404
CENTRAL_DB_USER=sa
CENTRAL_DB_PASSWORD=your_secure_db_password_here
CENTRAL_DB_NAME=CentralDB

# LINKED SERVER NAMES
LINKED_HUE=HUE_SERVER
LINKED_SAIGON=SG_SERVER
LINKED_HANOI=HN_SERVER
