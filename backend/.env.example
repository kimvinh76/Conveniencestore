PORT=3001
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ===== EMAIL CONFIGURATION (for Nodemailer) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME="Hệ thống Cửa hàng tiện lợi"
EMAIL_FROM_ADDRESS=

# ============================================================================
# HUE (Chi nhánh Huế) - Docker Port 1433

# HUE_DB_HOST: Địa chỉ IP hoặc hostname của server SQL Server chứa dữ liệu Huế
# HUE_DB_PORT: Cổng kết nối (Chạy Docker nên tất cả dùng chung port chuẩn 1433)
# HUE_DB_USER: Tên người dùng SQL Server (mặc định Docker dùng 'sa')
# HUE_DB_PASSWORD: Mật khẩu SQL Server
# HUE_DB_NAME: Tên database chứa dữ liệu Huế (Store_H)
HUE_DB_HOST=localhost
HUE_DB_PORT=1433
HUE_DB_USER=sa
HUE_DB_PASSWORD=YourStrong(!)Password123
HUE_DB_NAME=Store_H

# ============================================================================
# SAIGON (Chi nhánh Sài Gòn) - Docker Port 1433

# Cấu trúc tương tự HUE, kết nối đến database Sài Gòn
SAIGON_DB_HOST=localhost
SAIGON_DB_PORT=1433
SAIGON_DB_USER=sa
SAIGON_DB_PASSWORD=YourStrong(!)Password123
SAIGON_DB_NAME=Store_SG

# ============================================================================
# HANOI (Chi nhánh Hà Nội) - Docker Port 1433

# Cấu trúc tương tự HUE, kết nối đến database Hà Nội
HANOI_DB_HOST=localhost
HANOI_DB_PORT=1433
HANOI_DB_USER=sa
HANOI_DB_PASSWORD=YourStrong(!)Password123
HANOI_DB_NAME=Store_HN

# ============================================================================
# CENTRAL (Trung tâm) - Docker Port 1433

# Database trung tâm quản lý: sản phẩm gốc, nhân viên trung tâm, điều chuyển kho
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=1433
CENTRAL_DB_USER=sa
CENTRAL_DB_PASSWORD=YourStrong(!)Password123
CENTRAL_DB_NAME=CentralDB

# Auth login chỉ đọc từ CentralDB, tài khoản chi nhánh phải được đồng bộ về đây.
# Production: set NODE_ENV=production, JWT_SECRET mạnh, FRONTEND_ORIGIN đúng domain, COOKIE_SECURE=true.

# ============================================================================
# LINKED SERVERS CONFIG (Cho chức năng truy vấn phân tán)
LINKED_HUE=HUE_SERVER
LINKED_SAIGON=SG_SERVER
LINKED_HANOI=HN_SERVER
