# ==========================================
# CẤU HÌNH BẢO MẬT DÀNH CHO DOCKER COMPOSE
# ==========================================
# HƯỚNG DẪN: Copy file này thành file ".env" và điền mật khẩu thật của bạn vào.
# KHÔNG ĐƯỢC push file ".env" lên git!

# Mật khẩu cho user 'sa' của SQL Server
MSSQL_SA_PASSWORD=your_secure_db_password_here

# Chuỗi bí mật dùng để mã hóa JSON Web Token của Backend
JWT_SECRET=your_secure_jwt_secret_string_here

# Mật khẩu Email gửi thông báo (App Password)
EMAIL_PASS=your_gmail_app_password_here
