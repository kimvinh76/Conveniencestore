    "payload": {
      "oldPassword": "wrongpassword",
      "newPassword": "newpassword123"
    },
    "expected_status": 401
  },
  {
    "test_case_name": "Bad - Thiếu mật khẩu mới",
    "run_as": "nv_sales",
    "payload": {
      "oldPassword": "123456",
      "newPassword": ""
    },
    "expected_status": 400
  },
  {
    "test_case_name": "Bad - Chưa đăng nhập đổi mật khẩu",
    "run_as": "none",
    "payload": {
      "oldPassword": "123456",
      "newPassword": "newpassword123"
    },
    "expected_status": 401
  }
